  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::LaReina.DigitalTwin.RoomMetadata
  source: 'Sala: sala opcion 2 .fbx; mesa: sala 002.fbx'
  externalDimensions: {x: 8, y: 2.7, z: 9}
  chairCount: 11
  scaleNote: "1 unidad Unity = 1 metro. Sala 8 \xD7 9 m; mesa oval 2,27046 \xD7 2,80172
    m, tablero inicial a 0,76275 m y proyecci\xF3n a 0,77382 m. \xC1rea interior
    ampliada a 1,87046 \xD7 2,40172 m y borde blanco de 20 cm. U/J ajustan mesa;
    I/K ajustan mapa; 0 restablece. Alturas temporales, sin guardar entre ejecuciones.
    Asientos a 0,47 m; ojos a 1,18 m sentado. Once sillas en U; resto de la sala
    conservado."
