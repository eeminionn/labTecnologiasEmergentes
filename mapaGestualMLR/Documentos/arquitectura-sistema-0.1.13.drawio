          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="5.select" value="SELECCIÓN → módulo 6&#10;Otros dedos pueden estar extendidos. Conservar dueño válido aunque entre otra mano." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#eaf3ff;strokeColor=#0969da;fontSize=13;" vertex="1" parent="1">
