        <mxCell id="6.3" value="Nuevo actor/destino: iniciar reloj fresco&#10;Ancla motor = índice inicial. SelectionFeedback retiene centro y bounds del objetivo." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#eaf3ff;strokeColor=#0969da;fontSize=14;" vertex="1" parent="1">
