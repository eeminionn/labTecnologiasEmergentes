        <mxCell id="6.cancel" value="Cancelar dwell y feedback&#10;Salida/cambio → nuevo reloj.&#10;Pérdida/gap/foco/calidad/2OK → protección de rearme; sin heredar tiempo." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#fff0ee;strokeColor=#cf3c33;fontSize=13;" vertex="1" parent="1">
