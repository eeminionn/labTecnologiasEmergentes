        <mxCell id="5.10" value="Si no: reposo&#10;Seguir mostrando ambas sombras → 8" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=50;fillColor=#eaf3ff;strokeColor=#0969da;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="885" y="2955" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e63" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="5.9" target="5.10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="5.zoom" value="ZOOM → módulo 7&#10;Mayor separación acerca; menor aleja. Cancela dwell." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#fff6dd;strokeColor=#b77900;fontSize=13;" vertex="1" parent="1">
