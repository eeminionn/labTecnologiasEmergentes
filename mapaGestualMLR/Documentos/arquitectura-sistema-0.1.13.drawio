        <mxCell id="6.release" value="release-required / reposo&#10;Otro actor habilitado puede seleccionar. Esperar salida ≥120 ms." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=13;" vertex="1" parent="1">
