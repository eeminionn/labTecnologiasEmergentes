        <mxCell id="4.quality" value="Bloqueo inmediato: imagen inválida o saturación severa.&#10;Negro: media≤12 y ≥98% luminancia≤5.&#10;Blanco: media≥248 y ≥98% luminancia≥250.&#10;Aviso tras 200 ms; recuperar con 600 ms saludables.&#10;Contraste/luz/detalle: diagnósticos; blur aislado no bloquea." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;shape=note;size=18;align=left;fillColor=#fff6dd;strokeColor=#b77900;fontSize=13;" vertex="1" parent="1">
