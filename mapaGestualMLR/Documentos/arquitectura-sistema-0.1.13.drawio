          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="8.10" value="Abrir popup + avanzar PointSequence 1→2→3&#10;Sólo siguiente activo pulsa. Al completar: sin activo.&#10;Fin del resultado → próximo frame (2)." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=50;fillColor=#e6f6f3;strokeColor=#087f6e;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="885" y="4355" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e108" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="8.9" target="8.10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="8.none" value="Sin evento o bloqueado&#10;Conservar feedback fresco; volver al bucle (2)." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1380" y="3687" width="255" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e109" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="8.4" target="8.none">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="8.pan" value="PAN: transformar event.dx/dy por espejo/rotación; mapa.pan(dx,dy). OSM panBy; Google adapta centro." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#f2ecff;strokeColor=#8250df;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1380" y="3798" width="255" height="123" as="geometry" />
        </mxCell>
        <mxCell id="e110" value="Pan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#8250df;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="8.5" target="8.pan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="8.zoom" value="ZOOM: transformar punto medio&#10;mapa.zoom(delta,x,y). Limitar zoom y conservar ancla. Actualizar cartografía." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#fff6dd;strokeColor=#b77900;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1380" y="3960" width="255" height="124" as="geometry" />
        </mxCell>
        <mxCell id="e111" value="Zoom" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#b77900;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="8.5" target="8.zoom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="8.reject" value="Respuesta IPC (feedback)&#10;Ack true: contar clic + ripple. False/error: limpiar selección.&#10;Si falla validación, no enviar entrada. Excluye barra superior 56 px y footer 28 px." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#fff0ee;strokeColor=#cf3c33;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1380" y="4150" width="255" height="176" as="geometry" />
        </mxCell>
        <mxCell id="e112" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#cf3c33;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="8.7" target="8.reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="8.button" value="Botón/herramienta: ejecutar su acción. Popup cambia texto y se deshabilita; no avanza recorrido. Fin → próximo frame (2)." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#e6f6f3;strokeColor=#087f6e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1380" y="4360" width="255" height="138" as="geometry" />
        </mxCell>
        <mxCell id="e113" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#087f6e;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="8.9" target="8.button">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e114" value="Ack → feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="8.8" target="8.reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="8.note" value="Evento válido:&#10;Click: actor/target. Pan/zoom: modo/IDs.&#10;El manejador DOM recibe entrada nativa y ejecuta acción; ack informa envío aceptado, no gobierna recorrido.&#10;Home encuadra sin reset. Entrada sólo ventana propia, sin cursor global." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;shape=note;size=18;align=left;fillColor=#e6f6f3;strokeColor=#087f6e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1380" y="3368" width="255" height="245" as="geometry" />
        </mxCell>
        <mxCell id="panel9" value="" style="rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#d0d7de;strokeWidth=1.5;container=0;" vertex="1" parent="1">
          <mxGeometry x="1690" y="3230" width="800" height="1370" as="geometry" />
        </mxCell>
        <mxCell id="pt9" value="9  Opciones, errores y cierre" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="1710" y="3245" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ps9" value="Flujos laterales aplicables a todo el ciclo; nunca recuperan un dwell viejo." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1710" y="3291" width="760" height="48" as="geometry" />
        </mxCell>
        <mxCell id="9.1" value="¿Qué evento de usuario/sistema?" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rhombus;perimeter=rhombusPerimeter;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1715" y="3356" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="9.2" value="Ajustes: cámara, espejo, rotación, proveedor/key, confianza 0,60/0,70/0,80, auto y controles disponibles." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1715" y="3467" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e115" value="Ajustes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="9.1" target="9.2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9.3" value="¿Guardar Ajustes?" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rhombus;perimeter=rhombusPerimeter;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1715" y="3578" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e116" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="9.2" target="9.3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9.4" value="Espacio: pausa/reanuda · Escape: cancela&#10;Blur/documento oculto: pausa y cancela. Recuperar foco no reanuda automáticamente." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1715" y="3689" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="9.5" value="Durante pausa/Ajustes/Ayuda&#10;Mantener cámara, inferencia y preview frescos; bloquear clic/pan/zoom (4)." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1715" y="3800" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e118" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="9.4" target="9.5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9.6" value="Detener / desconectar / worker error&#10;Invalidar generación, parar tracks, terminar worker, loop y preview; cancelar acciones." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1715" y="3911" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="9.7" value="Métricas: frames/FPS, clics aceptados, pan/zoom, razones de selección, marca humana de falso clic y tiempos p50/p95." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1715" y="4022" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="9.8" value="Exportar JSON local (≤10.000 muestras)&#10;Sin imágenes ni landmarks. Captura→resultado no incluye buffer físico ni presentación; no es latencia extremo a extremo." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1715" y="4133" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e121" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="9.7" target="9.8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9.9" value="Cerrar aplicación → liberar recursos&#10;Iniciar otra sesión comienza seguimiento y tiempos nuevos." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=50;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1715" y="4244" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e123" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9.1" target="9.4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1704" y="3400" />
              <mxPoint x="1704" y="3733.0" />
