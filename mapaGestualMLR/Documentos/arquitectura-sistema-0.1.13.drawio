          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="5.pan" value="PAN → módulo 7&#10;Uno o dos puños.&#10;Mano libre no participa." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#f2ecff;strokeColor=#8250df;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1380" y="2854" width="255" height="88" as="geometry" />
