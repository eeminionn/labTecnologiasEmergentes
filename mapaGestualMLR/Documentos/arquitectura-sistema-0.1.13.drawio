              <mxPoint x="2195" y="3400" />
              <mxPoint x="2195" y="3955" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="9.controls" value="Controles de track sólo si soportados:&#10;brillo, contraste, compensación exposición; auto exposición/enfoque/balance de blancos continuos si disponibles.&#10;applyConstraints + comprobar getSettings: soportado/ inválido/ fallo/ mismatch/ sin verificar.&#10;No CLAHE ni retoque RGB antes del modelo." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;shape=note;size=18;align=left;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2210" y="3688" width="255" height="255" as="geometry" />
        </mxCell>
        <mxCell id="9.private" value="PRIVACIDAD Y SEGURIDAD&#10;Video/modelo/reglas: locales.&#10;Worker CSP connect-src self; bloqueo adicional odml.pa.googleapis.com.&#10;Renderer permite red de mapas.&#10;API key en configuración local.&#10;Permiso media sólo ventana/origen local; sin audio.&#10;Ningún frame se publica en repositorio ni servidor de inferencia." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;shape=note;size=18;align=left;fillColor=#e6f6f3;strokeColor=#087f6e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2210" y="4012" width="255" height="314" as="geometry" />
        </mxCell>
        <mxCell id="9.cancel" value="Cancelar Ajustes: cerrar diálogo&#10;Sin persistir ni reiniciar cámara. Volver al flujo (4) respetando pausa y foco." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2210" y="3578" width="255" height="94" as="geometry" />
        </mxCell>
        <mxCell id="e127" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9.3" target="9.cancel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9.save" value="Persistir localStorage&#10;Proveedor/key cambian: recargar renderer (cámara detenida) → 1.&#10;Si no: reiniciar sólo si cámara activa → 2; si detenida, mantener detenida." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=50;fillColor=#eaf3ff;strokeColor=#0969da;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2210" y="3356" width="255" height="194" as="geometry" />
        </mxCell>
        <mxCell id="e128" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#0969da;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9.3" target="9.save">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9.reset" value="Reset recorrido: cerrar popup, volver al punto 1.&#10;Ajustes/Ayuda abiertos bloquean acciones, incluido el dwell.&#10;Pruebas smoke con fixtures pertenecen a validación, no al flujo de uso real." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;shape=note;size=18;align=left;fillColor=#eaf3ff;strokeColor=#0969da;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1715" y="4380" width="430" height="156" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Fuentes: electron/main.cjs, src/main.js, vision.worker.js, gestures.js, ok-geometry.js, point-geometry.js, selection.js, mapping.js, frame-quality.js, camera-quality.js, map.js y sequence.js.&#10;Arquitectura funcional del prototipo: los puntos son ficticios y la cámara es frontal. El SDK neural entrega landmarks; la lógica de gestos, identidad, adquisición, dwell y rearme es código propio." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="4660" width="2440" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>