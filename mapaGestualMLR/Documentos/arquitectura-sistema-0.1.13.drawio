        <mxCell id="e66" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#8250df;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="5.9" target="5.pan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="5.rules" value="OK: proximidad 4–8/palma&#10;entrada≤0,28; salida≤0,40; apoyo de ≥2 dedos + cierre de índice u oposición de pulgar.&#10;Puño: flexión positiva de 4 dedos, compacidad y pulgar; imagen completa. No equivale a “no abierta”.&#10;Índice extendido contradice falso puño world.&#10;Sin tracks o &gt;2 manos → cancelar/reposo." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;shape=note;size=18;align=left;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1965" width="255" height="362" as="geometry" />
        </mxCell>
        <mxCell id="5.targets" value="Área mínima de objetivo: 44 CSS px.&#10;POI propio: 56 px. Botones tienen prioridad.&#10;POIs arbitrarios del SDK no son objetivos gestuales automáticos." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;shape=note;size=18;align=left;fillColor=#e6f6f3;strokeColor=#087f6e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1380" y="2364" width="255" height="173" as="geometry" />
        </mxCell>
        <mxCell id="panel6" value="" style="rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#d0d7de;strokeWidth=1.5;container=0;" vertex="1" parent="1">
          <mxGeometry x="1690" y="1830" width="800" height="1370" as="geometry" />
        </mxCell>
        <mxCell id="pt6" value="6  Selección estable · 1,5 segundos" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="1710" y="1845" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ps6" value="Índice sobre objetivo. La postura de los otros dedos no condiciona el dwell." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1710" y="1891" width="760" height="48" as="geometry" />
        </mxCell>
        <mxCell id="6.1" value="Elegir actor: mantener dueño válido&#10;Hold existente → seguir pending/confirmed. Nuevo destino → comprobar disponibilidad. Otro candidato disponible puede tomar turno." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#eaf3ff;strokeColor=#0969da;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1715" y="1956" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="6.2" value="Sólo NUEVO dwell:&#10;¿Destino rearmado y disponible?" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rhombus;perimeter=rhombusPerimeter;fillColor=#eaf3ff;strokeColor=#0969da;fontSize=14;" vertex="1" parent="1">
