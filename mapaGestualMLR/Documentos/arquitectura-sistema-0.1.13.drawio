        <mxCell id="8.1" value="renderGesture: validar actor y objetivos&#10;Aplicar cancelaciones. Completar hasta dos halos usando landmarks frescos; fallback sólo visual." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#e6f6f3;strokeColor=#087f6e;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="885" y="3356" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="8.2" value="Sólo selección: SelectionFeedback&#10;Verifica índice vivo/región/ancla/viewport. Si falla, cancelar clic. Pan/zoom omiten esta validación de target." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#e6f6f3;strokeColor=#087f6e;fontSize=14;" vertex="1" parent="1">
