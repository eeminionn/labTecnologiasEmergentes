        <mxCell id="6.7" value="Emitir un único evento click&#10;click-confirmed; bloquear ese destino para esa mano. Renderer debe validar y aceptar → 8." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#eaf3ff;strokeColor=#0969da;fontSize=14;" vertex="1" parent="1">
