        <mxCell id="e126" value="Detener/error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#cf3c33;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="9.1" target="9.6">
          <mxGeometry relative="1" as="geometry">
