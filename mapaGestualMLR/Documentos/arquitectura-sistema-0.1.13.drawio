        <mxCell id="8.8" value="sendInputEvent nativo en propia ventana&#10;mouseMove → mouseDown → mouseUp.&#10;El manejador DOM ejecuta la acción; IPC responde ack en paralelo." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#e6f6f3;strokeColor=#087f6e;fontSize=14;" vertex="1" parent="1">
