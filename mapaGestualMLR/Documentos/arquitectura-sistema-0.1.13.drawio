        <mxCell id="7.2" value="¿Modo pan o zoom?" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rhombus;perimeter=rhombusPerimeter;fillColor=#fff6dd;strokeColor=#b77900;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="55" y="3467" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="7.1" target="7.2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7.3" value="PAN: media de nudillos MCP 5/9/13/17&#10;Un puño → su referencia. Dos → media. Mano libre ignorada. Deltas por movimiento incremental." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#fff6dd;strokeColor=#b77900;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="55" y="3578" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="7.4" value="ZOOM: separación de índices en imagen&#10;Corregir aspecto; punto medio = ancla. No comparar world entre manos. No zoom por traslación común." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#fff6dd;strokeColor=#b77900;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="55" y="3689" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="7.5" value="¿Referencias válidas y, para zoom,&#10;separación bruta/filtrada≥0,10?" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rhombus;perimeter=rhombusPerimeter;fillColor=#fff6dd;strokeColor=#b77900;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="55" y="3800" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="7.6" value="¿Adquisición continua≥180 ms?" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rhombus;perimeter=rhombusPerimeter;fillColor=#fff6dd;strokeColor=#b77900;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="55" y="3911" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e87" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="7.5" target="7.6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7.7" value="Al adquirir: fijar base actual; mode navigate&#10;Pan: emitir si distancia≥0,003.&#10;Zoom: log2(separación/base)×gain; cambio≥0,008 y distancia≥0,003. Quieto mantiene modo." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#fff6dd;strokeColor=#b77900;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="55" y="4022" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e88" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1f2328;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#57606a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="7.6" target="7.7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7.8" value="Al emitir: actualizar base&#10;Renderer valida modo e IDs → 8.&#10;Pan y zoom no generan eventos cruzados." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;rounded=1;arcSize=10;fillColor=#fff6dd;strokeColor=#b77900;fontSize=14;" vertex="1" parent="1">
