        </mxCell>
        <mxCell id="4.times" value="Tiempos diferentes:&#10;Resultado viejo &gt;150 ms.&#10;Watchdog renderer &gt;180 ms.&#10;Gap motor ≥180 ms.&#10;Gap calidad &gt;250 ms o timestamp no creciente → bloquear continuidad." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2328;spacing=10;strokeWidth=1.5;shape=note;size=18;align=left;fillColor=#f6f8fa;strokeColor=#57606a;fontSize=13;" vertex="1" parent="1">
